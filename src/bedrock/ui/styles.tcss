/* Layout and colours for the chat screen. Textual CSS, not web CSS. */

Screen {
    background: $background;
}

/* ---- Top status bar ---------------------------------------------------- */

StatusBar {
    dock: top;
    height: 1;
    background: $panel;
    padding: 0 1;
}

#status-title {
    width: 1fr;
    text-style: bold;
    color: $accent;
}

#status-workspace, #status-model {
    width: auto;
    color: $text-muted;
    margin-right: 3;
}

#status-connection {
    width: auto;
}
#status-connection.ok      { color: $success; }
#status-connection.bad     { color: $error; }
#status-connection.unknown { color: $warning; }

AgentPanel {
    dock: top;
    height: auto;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

ApprovalPrompt {
    margin-bottom: 1;
    padding: 1;
    height: auto;
    border-left: thick $warning;
    background: transparent;
}

#approval-buttons { height: auto; margin-top: 1; }
#approval-buttons Button { margin-right: 2; min-width: 16; }

/* ---- Conversation sidebar ---------------------------------------------- */

#body {
    height: 1fr;
}

ConversationList {
    width: 30;
    height: 1fr;
    padding: 1 0;
    border: none;
    border-right: vkey $panel-lighten-2;
    background: $surface;
    /* One line per conversation, cut off with "…", like a chat app's sidebar. */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
ConversationList:focus {
    border: none;
    border-right: vkey $accent;
}

#main {
    width: 1fr;
}

/* A decision that was sent but never confirmed. It stays on the screen,
   visibly unfinished, rather than being cleared away as if it had worked. */
ApprovalPrompt.unresolved {
    border-left: thick $error;
}

#approval-status {
    height: auto;
    color: $text-muted;
}
ApprovalPrompt.unresolved #approval-status {
    color: $error;
}

/* ---- Conversation area -------------------------------------------------- */

#chat {
    padding: 1 2;
}

UserMessage, AssistantMessage, SystemNotice {
    margin-bottom: 1;
    padding: 0 1;
    height: auto;
}

UserMessage {
    border-left: thick $accent;
    color: $text;
}

AssistantMessage {
    border-left: thick $secondary;
    background: transparent;
}

SystemNotice {
    border-left: thick $foreground-muted;
    color: $text-muted;
    background: transparent;
}
SystemNotice.error {
    border-left: thick $error;
    color: $error;
}

/* Markdown widgets add their own padding; keep messages compact. */
AssistantMessage MarkdownBlock, SystemNotice MarkdownBlock {
    margin: 0 0 1 0;
}

/* ---- Input ------------------------------------------------------------- */

#prompt {
    dock: bottom;
    margin: 0 2 1 2;
    border: tall $accent;
}
#prompt:disabled {
    border: tall $foreground-muted;
    color: $text-muted;
}

/* ---- Pending prompts (display-only queue panel) ------------------------ */

PromptQueuePanel {
    height: auto;
    padding: 0 1;
    background: $panel;
}
PromptQueuePanel .queue-heading { height: 1; text-style: bold; }
PromptQueuePanel .queue-running { height: auto; max-height: 2; color: $accent; }
PromptQueuePanel .queue-empty { height: 1; color: $text-muted; }
PromptQueuePanel #queue-pending {
    height: auto;
    max-height: 4;
    padding: 0;
    border: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
PromptQueuePanel .queue-actions { height: 3; }
PromptQueuePanel .queue-actions Button { width: auto; min-width: 8; margin-right: 1; }
PromptQueuePanel .queue-hint { height: auto; color: $text-muted; }
