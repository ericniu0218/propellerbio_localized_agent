.venv/
.venv-*/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
package-lock.json

# Benchmark runs: one directory per run, a few hundred KB each. The scores
# worth keeping are in docs/litreview/BENCHMARK_RESULTS.md and the trend is in
# history.jsonl.
evals/litreview/results/*/
!evals/litreview/results/history.jsonl

# The agent-pack server (src/bedrock/server/). Its data now defaults to
# ~/.local/share/bedrock/server, but a deployment that keeps the old
# working-directory paths (WORKSPACE_DATA_DIR=data/workspace and friends) must
# still never commit recorded meetings or workspace records.
data/workspace/
data/recordings/
data/demo-recorder/
agent_pack*.db
scripts/server/eval/build/
