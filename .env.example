# Copy to .env and adjust for real-mode deployment. Mock mode needs none of this.

AGENT_PACK_MODE=mock          # mock | real
DATABASE_URL=sqlite:///./agent_pack.db   # real mode: postgresql+psycopg2://user:pass@host:5432/agent_pack
REDIS_URL=redis://localhost:6379/0
AIRGAP_CHECK=true

# Model endpoints (real mode only) — see config/models.yaml
DIRECTOR_LLM_URL=http://director-llm:8001/v1
SPECIALIST_LLM_URL=http://specialist-llm:8002/v1
RUNNER_LLM_URL=http://runner-llm:8003/v1

# Meeting transcripts (optional) — the customer's own datacenter connector,
# reachable over the INTERNAL network only. See zoom-transcript-vault's README
# ("Datacenter connector contract", endpoint 3) and docs/MEETINGS.md.
# Pointing this at the public Zoom relay would defeat the air gap and is
# refused unless AGENT_PACK_ALLOW_PUBLIC_DATACENTER=true.
DATACENTER_BASE_URL=http://transcripts.internal:8080
DATACENTER_SIGNING_SECRET=change-me-shared-with-the-connector
DATACENTER_TIMEOUT_S=30
