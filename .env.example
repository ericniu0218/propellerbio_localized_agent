# Copy to .env and adjust for real-mode deployment. Mock mode needs none of this.

AGENT_PACK_MODE=mock          # mock | real
DATABASE_URL=sqlite:///./agent_pack.db   # real mode: postgresql+psycopg2://user:pass@host:5432/agent_pack
REDIS_URL=redis://localhost:6379/0
AIRGAP_CHECK=true

# Model endpoints (real mode only) — see config/models.yaml
DIRECTOR_LLM_URL=http://director-llm:8001/v1
SPECIALIST_LLM_URL=http://specialist-llm:8002/v1
RUNNER_LLM_URL=http://runner-llm:8003/v1
