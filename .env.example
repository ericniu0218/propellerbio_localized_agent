# Copy to .env and adjust for real-mode deployment. Mock mode needs none of this.

AGENT_PACK_MODE=mock          # mock | real
DATABASE_URL=sqlite:///./agent_pack.db   # real mode: postgresql+psycopg2://user:pass@host:5432/agent_pack
REDIS_URL=redis://localhost:6379/0
AIRGAP_CHECK=true

# Model endpoints (real mode only) — see config/models.yaml
DIRECTOR_LLM_URL=http://director-llm:8001/v1
SPECIALIST_LLM_URL=http://specialist-llm:8002/v1
RUNNER_LLM_URL=http://runner-llm:8003/v1

# meeting_transcripts tool: the datacenter connector's internal-network
# address (never a public internet URL — see app/tools/meeting_transcripts.py
# for why) and the HMAC secret shared with zoom-transcript-vault, which
# pushes transcripts into this same connector. Without these, the tool
# reports itself as unconfigured rather than failing at call time.
DATACENTER_BASE_URL=http://transcript-store.internal:8080
DATACENTER_SIGNING_SECRET=
